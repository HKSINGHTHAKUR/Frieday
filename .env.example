# Node + Express backend (Frieday server)/
# Authoritative structure: architecture.md §4. Phase 0: foundation only (T0.2).

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Defaults to local dev DB when unset.
# MONGO_URI=mongodb://127.0.0.1:27017/frieday

# App session signing key (required, min 16 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# GitHub token encryption key (required, exactly 64 hex chars = 32 bytes for AES-256-GCM; T1.2).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# GitHub OAuth App (Phase 1 — T1.1). Create an OAuth App at
# github.com/settings/developers with a callback URL of GITHUB_CALLBACK_URL.
# Leave empty until your OAuth App exists.
#
# ONE OAuth App holds ONE "Authorization callback URL", so local development
# and production need SEPARATE OAuth Apps (separate client id + secret) and
# separate callback URLs:
#
#   local dev  -> callback http://localhost:5000/api/auth/github/callback
#   production -> callback https://<public-host>/api/auth/github/callback
#
# The values below are for LOCAL DEVELOPMENT. Production takes its values from
# the Render environment, never from this file — the server refuses to load
# .env when NODE_ENV=production, and refuses to boot if the production
# callback resolves to a localhost URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPES=read:user repo
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# GitHub endpoint overrides — dev/CI test doubles only (T1.1).
# Defaults point at github.com; leave commented unless running a local stub.
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_USER_URL=https://api.github.com/user

# Sync caps + concurrency (Phase 2 — T2.1/T2.2). Defaults apply when unset.
# SYNC_CONCURRENCY: max concurrent GitHub requests during a sync (default 2, min 1).
SYNC_CONCURRENCY=2
SYNC_MAX_REPOS=100
SYNC_MAX_COMMITS_PER_REPO=500
SYNC_MAX_PRS_PER_REPO=300
SYNC_MAX_ISSUES_PER_REPO=300

# Scheduler: disabled in MVP/Phase 0 (manual sync only, Phase 2+).
SCHEDULER_ENABLED=false

# AI explanation layer: disabled until V1 Phase 6. No LLM SDK in MVP (rules.md §16).
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI provider API key (V1 Phase 6 — T6.2). Set only when a live provider is
# configured and approved. Never commit real values.
# AI_API_KEY=<obtained from Google AI Studio>
# Verified low-cost model: gemini-3.5-flash-lite ($0.30/1M input, $2.50/1M output). See https://ai.google.dev/gemini-api/docs/models
# Configure AI_API_KEY in the Render dashboard; do not commit it here.

# Webhook secret (V1 Phase 7). Unused in MVP.
WEBHOOK_SECRET=

# Logging verbosity: debug|info|warn|error (default: info; silent under NODE_ENV=test).
LOG_LEVEL=info
